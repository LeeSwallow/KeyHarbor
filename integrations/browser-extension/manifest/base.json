{
  "manifest_version": 3,
  "name": "KeyHarbor: hand off a site",
  "short_name": "KeyHarbor",
  "description": "Hand a site's login to a KeyHarbor agent session, and fill or save logins from the KeyHarbor vault on this Mac.",
  "permissions": ["cookies", "nativeMessaging", "activeTab", "scripting", "storage", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "32": "icon-32.png", "128": "icon-128.png" },
  "action": { "default_title": "KeyHarbor", "default_popup": "popup.html", "default_icon": { "32": "icon-32.png" } }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyHarbor",
  "version": "0.1.1",
  "identifier": "io.github.leeswallow.keyharbor",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "npm run build && cargo build --release --locked --manifest-path ../../Cargo.toml -p keyharbor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KeyHarbor",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Helpers/keyharbor": "../target/release/keyharbor"
      }
    },
    "category": "Utility",
    "copyright": "LeeSwallow, MIT OR Apache-2.0"
  }
}

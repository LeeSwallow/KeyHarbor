{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyHarbor",
  "version": "0.1.0",
  "identifier": "io.github.leeswallow.keyharbor.app",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KeyHarbor",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "copyright": "LeeSwallow, MIT OR Apache-2.0"
  }
}
